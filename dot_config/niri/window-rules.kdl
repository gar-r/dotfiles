window-rule {
  match app-id=r#"Pinentry.*"#
  open-floating true
}

window-rule {
  match app-id=r#"librewolf"# title="^Picture-in-Picture$"
  open-floating true
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
}

window-rule {
  match app-id=r#"librewolf"#
  open-maximized true
}

window-rule {
  match app-id="^gimp"
  default-column-width { fixed 1200; }
}

window-rule {
  match app-id=r#"steam"# title=r#".*(Friends|Settings|Properties).*"#
  open-floating true
}

window-rule {
  match app-id=r#"jetbrains-studio"#
  open-fullscreen true
}

window-rule {
  match is-window-cast-target=true
  focus-ring {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }
}

// MO2 rules
window-rule {
  match app-id=r#"^steam_app_489830$"#
  exclude title=r#"Mod Organizer"#
  exclude title=r#"^Skyrim( Special Edition)?$"#
  open-floating true
}

// MO2 fallback rules
window-rule {
  match app-id=r#"(?i)^(xEdit|SSEEdit|TES[45]Edit|FO[47][66]?Edit|EnderalEdit|BodySlide|Outfit ?Studio|Pandora|PGPatcher|LOOT|DynDOLOD|TexGen|Nemesis|Wrye ?Bash|BethINI)"#
  open-floating true
}
